# Single-User Baseline Environment Variables for AlgoApp Pro v2

# Server Configuration
NODE_ENV=development
APP_PORT=4000
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
CORRELATION_HEADER=X-Request-Id

# Single-User PostgreSQL Database
DATABASE_URL=postgresql://algo_user:algo_password@localhost:5432/algoapp_db?schema=public

# CORS Settings
CORS_ORIGIN=http://localhost:3000
