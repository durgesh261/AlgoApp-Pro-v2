{
  "openapi": "3.0.3",
  "info": {
    "title": "QuantEdge AI REST API",
    "description": "Institutional-Grade Algorithmic Trading Platform API for Crypto Perpetual Futures.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/system/health": {
      "get": {
        "summary": "Get Core System Health",
        "responses": {
          "200": {
            "description": "System health metrics"
          }
        }
      }
    },
    "/tradingview/webhook": {
      "post": {
        "summary": "Receive TradingView Webhook Signal",
        "responses": {
          "200": {
            "description": "Webhook processed"
          }
        }
      }
    },
    "/indicator/analyze": {
      "post": {
        "summary": "Run PAT Lite & SMC Indicator Analysis",
        "responses": {
          "200": {
            "description": "Indicator state generated"
          }
        }
      }
    },
    "/strategy-profile": {
      "get": {
        "summary": "List Strategy Profiles",
        "responses": {
          "200": {
            "description": "Strategy profiles list"
          }
        }
      }
    },
    "/trade-accounting/summary": {
      "get": {
        "summary": "Get Trade Accounting Summary",
        "responses": {
          "200": {
            "description": "Accounting summary"
          }
        }
      }
    },
    "/operations-center/status": {
      "get": {
        "summary": "Get NOC Telemetry & 15 Service Health Status",
        "responses": {
          "200": {
            "description": "NOC telemetry status"
          }
        }
      }
    },
    "/trade-review/{tradeId}": {
      "get": {
        "summary": "Get Trade Review Details & AI Review",
        "responses": {
          "200": {
            "description": "Trade review details"
          }
        }
      }
    },
    "/shadow-trading/dashboard": {
      "get": {
        "summary": "Get Shadow Laboratory Dashboard Data & Production Readiness Score",
        "responses": {
          "200": {
            "description": "Shadow laboratory data"
          }
        }
      }
    }
  }
}
