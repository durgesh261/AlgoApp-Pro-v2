datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  displayName     String   @default("Algo Trader") @map("display_name")
  themePreference String   @default("dark") @map("theme_preference")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SystemSettings {
  id                    String   @id @default("default-settings")
  defaultCurrency       String   @default("USD") @map("default_currency")
  timezone              String   @default("UTC")
  maxStaleSignalSeconds Int      @default(60) @map("max_stale_signal_seconds")
  isKillSwitchActive    Boolean  @default(false) @map("is_kill_switch_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model PaperWallet {
  id              String   @id @default("default-paper-wallet")
  virtualBalance  Float    @default(50000.0) @map("virtual_balance")
  availableMargin Float    @default(50000.0) @map("available_margin")
  usedMargin      Float    @default(0.0) @map("used_margin")
  realizedPnL     Float    @default(0.0) @map("realized_pnl")
  unrealizedPnL   Float    @default(0.0) @map("unrealized_pnl")
  equity          Float    @default(50000.0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("paper_wallets")
}

model PaperOrder {
  id              String   @id @default(uuid())
  symbol          String
  side            String
  orderType       String   @map("order_type")
  price           Float?
  stopPrice       Float?   @map("stop_price")
  quantity        Float
  filledQuantity  Float    @default(0.0) @map("filled_quantity")
  status          String   @default("PENDING")
  stopLoss        Float?   @map("stop_loss")
  takeProfit      Float?   @map("take_profit")
  bracketParentId String?  @map("bracket_parent_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("paper_orders")
}

model PaperPosition {
  id              String   @id @default(uuid())
  symbol          String
  side            String
  entryPrice      Float    @map("entry_price")
  markPrice       Float    @map("mark_price")
  quantity        Float
  notionalValue   Float    @map("notional_value")
  unrealizedPnL   Float    @default(0.0) @map("unrealized_pnl")
  realizedPnL     Float    @default(0.0) @map("realized_pnl")
  leverage        Float    @default(10.0)
  marginAllocated Float    @map("margin_allocated")
  stopLoss        Float?   @map("stop_loss")
  takeProfit      Float?   @map("take_profit")
  openedAt        DateTime @default(now()) @map("opened_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("paper_positions")
}

model PaperRiskConfig {
  id                     String   @id @default("default-paper-risk")
  maxDailyLoss           Float    @default(1000.0) @map("max_daily_loss")
  maxDrawdownPercent     Float    @default(5.0) @map("max_drawdown_percent")
  maxOpenPositions       Int      @default(10) @map("max_open_positions")
  maxRiskPerTradePercent Float    @default(2.0) @map("max_risk_per_trade_percent")
  isEmergencyStopActive  Boolean  @default(false) @map("is_emergency_stop_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("paper_risk_configs")
}

model PaperTradeJournal {
  id           String   @id @default(uuid())
  eventType    String   @map("event_type")
  symbol       String?
  action       String
  details      String
  metadataJson String?  @map("metadata_json")
  timestamp    DateTime @default(now())

  @@map("paper_trade_journals")
}

model SupplyZone {
  id         String   @id @default(uuid())
  symbol     String
  timeframe  String   @default("1H")
  upperPrice Float    @map("upper_price")
  lowerPrice Float    @map("lower_price")
  source     String   @default("PIT_LITE")
  strength   Float    @default(80.0)
  width      Float
  freshness  Float    @default(100.0)
  touchCount Int      @default(0) @map("touch_count")
  status     String   @default("FRESH")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("supply_zones")
}

model DemandZone {
  id         String   @id @default(uuid())
  symbol     String
  timeframe  String   @default("1H")
  upperPrice Float    @map("upper_price")
  lowerPrice Float    @map("lower_price")
  source     String   @default("PIT_LITE")
  strength   Float    @default(80.0)
  width      Float
  freshness  Float    @default(100.0)
  touchCount Int      @default(0) @map("touch_count")
  status     String   @default("FRESH")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("demand_zones")
}

model StrategySignalLog {
  id              String   @id @default(uuid())
  symbol          String
  timeframe       String   @default("1H")
  outcome         String
  price           Float
  activeZoneId    String?  @map("active_zone_id")
  rationale       String
  confidenceScore Float    @default(90.0) @map("confidence_score")
  timestamp       DateTime @default(now())

  @@map("strategy_signal_logs")
}

model DecisionLog {
  id                String   @id @default(uuid())
  signalId          String   @map("signal_id")
  symbol            String
  timeframe         String   @default("1H")
  decisionState     String   @map("decision_state")
  confidenceScore   Float    @map("confidence_score")
  reasonCodesJson   String   @map("reason_codes_json")
  inputSnapshotHash String   @map("input_snapshot_hash")
  timestamp         DateTime @default(now())

  @@map("decision_logs")
}

model DecisionExplanation {
  id              String   @id @default(uuid())
  decisionId      String   @unique @map("decision_id")
  symbol          String
  decisionState   String   @map("decision_state")
  confidenceScore Float    @map("confidence_score")
  shortSummary    String   @map("short_summary")
  mediumSummary   String   @map("medium_summary")
  detailedSummary String   @map("detailed_summary")
  timestamp       DateTime @default(now())

  @@map("decision_explanations")
}

model DecisionTimeline {
  id            String   @id @default(uuid())
  explanationId String   @map("explanation_id")
  stepIndex     Int      @map("step_index")
  stage         String
  status        String
  description   String
  timestamp     DateTime @default(now())

  @@map("decision_timelines")
}

model DecisionReason {
  id              String  @id @default(uuid())
  explanationId   String  @map("explanation_id")
  reasonCode      String  @map("reason_code")
  humanExplanation String @map("human_explanation")
  isPassed        Boolean @default(true) @map("is_passed")

  @@map("decision_reasons")
}

model ReplayMetadata {
  id              String   @id @default(uuid())
  explanationId   String   @unique @map("explanation_id")
  snapshotHash    String   @map("snapshot_hash")
  confidenceScore Float    @map("confidence_score")
  metadataJson    String   @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("replay_metadata")
}
