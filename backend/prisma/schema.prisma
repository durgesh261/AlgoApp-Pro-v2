datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  displayName     String   @default("Algo Trader") @map("display_name")
  themePreference String   @default("dark") @map("theme_preference")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SystemSettings {
  id                    String   @id @default("default-settings")
  defaultCurrency       String   @default("USD") @map("default_currency")
  timezone              String   @default("UTC")
  maxStaleSignalSeconds Int      @default(60) @map("max_stale_signal_seconds")
  isKillSwitchActive    Boolean  @default(false) @map("is_kill_switch_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model PaperWallet {
  id              String   @id @default("default-paper-wallet")
  virtualBalance  Float    @default(10.0) @map("virtual_balance")
  availableMargin Float    @default(10.0) @map("available_margin")
  usedMargin      Float    @default(0.0) @map("used_margin")
  realizedPnL     Float    @default(0.0) @map("realized_pnl")
  unrealizedPnL   Float    @default(0.0) @map("unrealized_pnl")
  equity          Float    @default(10.0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("paper_wallets")
}

model PaperOrder {
  id              String   @id @default(uuid())
  symbol          String
  side            String
  orderType       String   @map("order_type")
  price           Float?
  stopPrice       Float?   @map("stop_price")
  quantity        Float
  filledQuantity  Float    @default(0.0) @map("filled_quantity")
  status          String   @default("PENDING")
  stopLoss        Float?   @map("stop_loss")
  takeProfit      Float?   @map("take_profit")
  bracketParentId String?  @map("bracket_parent_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([symbol, status])
  @@map("paper_orders")
}

model PaperPosition {
  id              String   @id @default(uuid())
  symbol          String
  side            String
  entryPrice      Float    @map("entry_price")
  markPrice       Float    @map("mark_price")
  quantity        Float
  notionalValue   Float    @map("notional_value")
  unrealizedPnL   Float    @default(0.0) @map("unrealized_pnl")
  realizedPnL     Float    @default(0.0) @map("realized_pnl")
  leverage        Float    @default(10.0)
  marginAllocated Float    @map("margin_allocated")
  stopLoss        Float?   @map("stop_loss")
  takeProfit      Float?   @map("take_profit")
  openedAt        DateTime @default(now()) @map("opened_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([symbol])
  @@map("paper_positions")
}

model PaperRiskConfig {
  id                     String   @id @default("default-paper-risk")
  maxDailyLoss           Float    @default(1000.0) @map("max_daily_loss")
  maxDrawdownPercent     Float    @default(5.0) @map("max_drawdown_percent")
  maxOpenPositions       Int      @default(10) @map("max_open_positions")
  maxRiskPerTradePercent Float    @default(2.0) @map("max_risk_per_trade_percent")
  isEmergencyStopActive  Boolean  @default(false) @map("is_emergency_stop_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("paper_risk_configs")
}

model PaperTradeJournal {
  id           String   @id @default(uuid())
  eventType    String   @map("event_type")
  symbol       String?
  action       String
  details      String
  metadataJson String?  @map("metadata_json")
  timestamp    DateTime @default(now())

  @@index([symbol, eventType])
  @@map("paper_trade_journals")
}

model SupplyZone {
  id         String   @id @default(uuid())
  symbol     String
  timeframe  String   @default("1H")
  upperPrice Float    @map("upper_price")
  lowerPrice Float    @map("lower_price")
  source     String   @default("PIT_LITE")
  strength   Float    @default(80.0)
  width      Float
  freshness  Float    @default(100.0)
  touchCount Int      @default(0) @map("touch_count")
  status     String   @default("FRESH")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([symbol, status])
  @@map("supply_zones")
}

model DemandZone {
  id         String   @id @default(uuid())
  symbol     String
  timeframe  String   @default("1H")
  upperPrice Float    @map("upper_price")
  lowerPrice Float    @map("lower_price")
  source     String   @default("PIT_LITE")
  strength   Float    @default(80.0)
  width      Float
  freshness  Float    @default(100.0)
  touchCount Int      @default(0) @map("touch_count")
  status     String   @default("FRESH")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([symbol, status])
  @@map("demand_zones")
}

model StrategySignalLog {
  id              String   @id @default(uuid())
  symbol          String
  timeframe       String   @default("1H")
  outcome         String
  price           Float
  activeZoneId    String?  @map("active_zone_id")
  rationale       String
  confidenceScore Float    @default(90.0) @map("confidence_score")
  timestamp       DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("strategy_signal_logs")
}

model DecisionLog {
  id                String   @id @default(uuid())
  signalId          String   @map("signal_id")
  symbol            String
  timeframe         String   @default("1H")
  decisionState     String   @map("decision_state")
  confidenceScore   Float    @map("confidence_score")
  reasonCodesJson   String   @map("reason_codes_json")
  inputSnapshotHash String   @map("input_snapshot_hash")
  timestamp         DateTime @default(now())

  @@index([symbol, decisionState])
  @@map("decision_logs")
}

model DecisionExplanation {
  id              String   @id @default(uuid())
  decisionId      String   @unique @map("decision_id")
  symbol          String
  decisionState   String   @map("decision_state")
  confidenceScore Float    @map("confidence_score")
  shortSummary    String   @map("short_summary")
  mediumSummary   String   @map("medium_summary")
  detailedSummary String   @map("detailed_summary")
  timestamp       DateTime @default(now())

  @@index([symbol, decisionId])
  @@map("decision_explanations")
}

model DecisionTimeline {
  id            String   @id @default(uuid())
  explanationId String   @map("explanation_id")
  stepIndex     Int      @map("step_index")
  stage         String
  status        String
  description   String
  timestamp     DateTime @default(now())

  @@index([explanationId, stepIndex])
  @@map("decision_timelines")
}

model DecisionReason {
  id               String  @id @default(uuid())
  explanationId    String  @map("explanation_id")
  reasonCode       String  @map("reason_code")
  humanExplanation String  @map("human_explanation")
  isPassed         Boolean @default(true) @map("is_passed")

  @@index([explanationId])
  @@map("decision_reasons")
}

model ReplayMetadata {
  id              String   @id @default(uuid())
  explanationId   String   @unique @map("explanation_id")
  snapshotHash    String   @map("snapshot_hash")
  confidenceScore Float    @map("confidence_score")
  metadataJson    String   @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("replay_metadata")
}

model TradingRuleConfig {
  id                 String   @id @default("default-trading-rules")
  ruleVersion        String   @default("v2.0.0") @map("rule_version")
  configVersion      String   @default("cfg-2026.08.02") @map("config_version")
  supportedPairsJson  String   @default("[\"BTCUSD.P\",\"ETHUSD.P\",\"SOLUSD.P\",\"XRPUSD.P\"]") @map("supported_pairs_json")
  supportedTimeframe String   @default("1H") @map("supported_timeframe")
  bonusesJson        String   @map("bonuses_json")
  riskRulesJson      String   @map("risk_rules_json")
  challengeRulesJson String   @map("challenge_rules_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("trading_rule_configs")
}

model TradingRuleAudit {
  id            String   @id @default(uuid())
  ruleVersion   String   @map("rule_version")
  configVersion String   @map("config_version")
  action        String
  changedBy     String   @default("SYSTEM") @map("changed_by")
  payloadJson   String   @map("payload_json")
  timestamp     DateTime @default(now())

  @@map("trading_rule_audits")
}

model MarketCandle {
  id        String   @id @default(uuid())
  symbol    String
  timeframe String   @default("1H")
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timestamp DateTime

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timestamp])
  @@map("market_candles")
}

model MarketSnapshot {
  id           String   @id @default(uuid())
  symbol       String   @unique
  currentPrice Float    @map("current_price")
  spread       Float
  session      String   @default("NEW_YORK")
  trend        String   @default("BULLISH")
  volatility   String   @default("MEDIUM")
  timestamp    DateTime @default(now())

  @@map("market_snapshots")
}

model MarketEvent {
  id          String   @id @default(uuid())
  symbol      String
  eventType   String   @map("event_type")
  payloadJson String   @map("payload_json")
  timestamp   DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("market_events")
}

model ReplaySession {
  id                 String   @id @default(uuid())
  symbol             String
  timeframe          String   @default("1H")
  currentCandleIndex Int      @default(0) @map("current_candle_index")
  totalCandles       Int      @default(100) @map("total_candles")
  status             String   @default("IDLE")
  speedMultiplier    Float    @default(1.0) @map("speed_multiplier")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("replay_sessions")
}

model ReplayEvent {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  eventType   String   @map("event_type")
  payloadJson String   @map("payload_json")
  timestamp   DateTime @default(now())

  @@index([sessionId, timestamp])
  @@map("replay_events")
}

model BacktestSession {
  id            String   @id @default(uuid())
  symbol        String
  timeframe     String   @default("1H")
  ruleVersion   String   @default("v2.0.0") @map("rule_version")
  configVersion String   @default("cfg-2026.08.02") @map("config_version")
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("backtest_sessions")
}

model BacktestTrade {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  symbol    String
  side      String
  entryPrice Float   @map("entry_price")
  exitPrice  Float   @map("exit_price")
  quantity   Float
  pnl       Float
  status    String
  timestamp DateTime @default(now())

  @@index([sessionId, symbol])
  @@map("backtest_trades")
}

model BacktestMetric {
  id            String   @id @default(uuid())
  sessionId     String   @unique @map("session_id")
  totalTrades   Int      @map("total_trades")
  winningTrades Int      @map("winning_trades")
  losingTrades  Int      @map("losing_trades")
  winRate       Float    @map("win_rate")
  lossRate      Float    @map("loss_rate")
  profitFactor  Float    @map("profit_factor")
  averageRR     Float    @map("average_rr")
  netPnL        Float    @map("net_pnl")
  maxDrawdown   Float    @map("max_drawdown")
  bestTradePnL  Float    @map("best_trade_pnl")
  worstTradePnL Float    @map("worst_trade_pnl")
  skippedTrades Int      @map("skipped_trades")
  invalidTrades Int      @map("invalid_trades")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("backtest_metrics")
}

model ExecutionSession {
  id            String   @id @default(uuid())
  mode          String   @default("PAPER")
  pair          String
  timeframe     String   @default("1H")
  decisionId    String   @map("decision_id")
  ruleVersion   String   @default("v2.0.0") @map("rule_version")
  configVersion String   @default("cfg-2026.08.02") @map("config_version")
  adapter       String   @default("PAPER_ADAPTER")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([pair, mode])
  @@map("execution_sessions")
}

model ExecutionRequest {
  id             String   @id @default(uuid())
  sessionId      String   @map("session_id")
  idempotencyKey String   @unique @map("idempotency_key")
  decisionId     String   @map("decision_id")
  symbol         String
  side           String
  mode           String   @default("PAPER")
  ruleVersion    String   @default("v2.0.0") @map("rule_version")
  configVersion  String   @default("cfg-2026.08.02") @map("config_version")
  orderType      String   @default("MARKET") @map("order_type")
  quantity       Float
  price          Float?
  stopLoss       Float?   @map("stop_loss")
  takeProfit     Float?   @map("take_profit")
  timestamp      DateTime @default(now())

  @@index([sessionId, idempotencyKey])
  @@map("execution_requests")
}

model ExecutionResult {
  id             String   @id @default(uuid())
  requestId      String   @unique @map("request_id")
  sessionId      String   @map("session_id")
  adapter        String
  status         String   @default("QUEUED")
  fillPrice      Float?   @map("fill_price")
  filledQuantity Float    @default(0.0) @map("filled_quantity")
  latencyMs      Int      @default(0) @map("latency_ms")
  message        String?
  timestamp      DateTime @default(now())

  @@index([sessionId, requestId])
  @@map("execution_results")
}

model ExecutionJournal {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  requestId String   @map("request_id")
  resultId  String   @map("result_id")
  adapter   String
  fromState String   @map("from_state")
  toState   String   @map("to_state")
  action    String
  details   String
  latencyMs Int      @default(0) @map("latency_ms")
  timestamp DateTime @default(now())

  @@index([sessionId, requestId])
  @@map("execution_journals")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  symbol      String
  timeframe   String   @default("1H")
  payloadJson String   @map("payload_json")
  signature   String?
  status      String   @default("PROCESSED")
  timestamp   DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("webhook_events")
}

model WebhookError {
  id         String   @id @default(uuid())
  symbol     String?
  errorType  String   @map("error_type")
  message    String
  rawPayload String   @map("raw_payload")
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@map("webhook_errors")
}

model ConnectionHealth {
  id               String   @id @default("tradingview-health")
  status           String   @default("CONNECTED")
  lastWebhookAt    DateTime @default(now()) @map("last_webhook_at")
  totalWebhooks    Int      @default(0) @map("total_webhooks")
  duplicateCount   Int      @default(0) @map("duplicate_count")
  droppedCount     Int      @default(0) @map("dropped_count")
  malformedCount   Int      @default(0) @map("malformed_count")
  averageLatencyMs Float    @default(0.0) @map("average_latency_ms")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("connection_health")
}

model PipelineTrace {
  id              String   @id @default(uuid())
  traceId         String   @unique @map("trace_id")
  symbol          String
  mode            String   @default("SHADOW")
  candleJson      String   @map("candle_json")
  structureJson   String   @map("structure_json")
  signalJson      String   @map("signal_json")
  decisionJson    String   @map("decision_json")
  explanationJson String   @map("explanation_json")
  executionJson   String   @map("execution_json")
  totalLatencyMs  Float    @default(0.0) @map("total_latency_ms")
  timestamp       DateTime @default(now())

  @@index([symbol, timestamp])
  @@map("pipeline_traces")
}

model StrategyProfile {
  id              String   @id @default(uuid())
  name            String
  description     String
  version         String   @default("1.0.0")
  isActive        Boolean  @default(true) @map("is_active")
  pair            String   @default("BTCUSD.P")
  timeframe       String   @default("1H")
  patConfigJson   String   @map("pat_config_json")
  smcConfigJson   String   @map("smc_config_json")
  riskConfigJson  String   @map("risk_config_json")
  execConfigJson  String   @map("exec_config_json")
  indConfigJson   String   @map("ind_config_json")
  decConfigJson   String   @map("dec_config_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("strategy_profiles")
}

model TradeLedger {
  id                String   @id @default(uuid())
  tradeId           String   @unique @map("trade_id")
  exchangeOrderId   String   @map("exchange_order_id")
  exchangeTradeId   String?  @map("exchange_trade_id")
  symbol            String
  timeframe         String   @default("1H")
  strategyProfileId String   @map("strategy_profile_id")
  strategyVersion   String   @default("1.0.0") @map("strategy_version")
  indicatorVersion  String   @default("1.0.0") @map("indicator_version")
  ruleVersion       String   @default("1.0.0") @map("rule_version")
  decisionVersion   String   @default("1.0.0") @map("decision_version")
  executionMode     String   @default("PAPER") @map("execution_mode")
  side              String
  entryPrice        Float    @map("entry_price")
  exitPrice         Float    @map("exit_price")
  quantity          Float
  marginUsed        Float    @map("margin_used")
  leverage          Float
  riskPercent       Float    @map("risk_percent")
  rewardPercent     Float    @map("reward_percent")
  stopLoss          Float    @map("stop_loss")
  takeProfit        Float    @map("take_profit")
  grossPnL          Float    @map("gross_pnl")
  tradingFee        Float    @map("trading_fee")
  fundingFee        Float    @map("funding_fee")
  tax               Float
  netPnL            Float    @map("net_pnl")
  durationSeconds   Int      @map("duration_seconds")
  executionLatencyMs Float   @map("execution_latency_ms")
  decisionConfidence Float   @map("decision_confidence")
  decisionExplanation String @map("decision_explanation")
  resultStatus      String   @map("result_status")
  syncStatus        String   @default("SIMULATED") @map("sync_status")
  executedAt        DateTime @default(now()) @map("executed_at")
  closedAt          DateTime @default(now()) @map("closed_at")

  @@map("trade_ledger")
}

model ChallengeSession {
  id                 String   @id @default("default-20day-challenge")
  startDate          DateTime @default(now()) @map("start_date")
  currentDay         Int      @default(1) @map("current_day")
  remainingDays      Int      @default(20) @map("remaining_days")
  initialBalance     Float    @default(50000.0) @map("initial_balance")
  currentBalance     Float    @default(50000.0) @map("current_balance")
  grossProfit        Float    @default(0.0) @map("gross_profit")
  netProfit          Float    @default(0.0) @map("net_profit")
  dailyTargetPercent Float    @default(0.5) @map("daily_target_percent")
  totalTargetPercent Float    @default(10.0) @map("total_target_percent")
  maxDailyDrawdownPercent Float @default(5.0) @map("max_daily_drawdown_percent")
  maxOverallDrawdownPercent Float @default(10.0) @map("max_overall_drawdown_percent")
  winningDays        Int      @default(0) @map("winning_days")
  losingDays         Int      @default(0) @map("losing_days")
  winStreak          Int      @default(0) @map("win_streak")
  lossStreak         Int      @default(0) @map("loss_streak")
  longestWinStreak   Int      @default(0) @map("longest_win_streak")
  longestLossStreak  Int      @default(0) @map("longest_loss_streak")
  status             String   @default("RUNNING")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("challenge_sessions")
}

model WalletState {
  id                 String   @id @default("default-wallet-state")
  currentBalance     Float    @default(50000.0) @map("current_balance")
  availableBalance   Float    @default(50000.0) @map("available_balance")
  usedMargin         Float    @default(0.0) @map("used_margin")
  equity             Float    @default(50000.0)
  realizedPnL        Float    @default(0.0) @map("realized_pnl")
  unrealizedPnL      Float    @default(0.0) @map("unrealized_pnl")
  grossPnL           Float    @default(0.0) @map("gross_pnl")
  netPnL             Float    @default(0.0) @map("net_pnl")
  dailyProfit        Float    @default(0.0) @map("daily_profit")
  weeklyProfit       Float    @default(0.0) @map("weekly_profit")
  monthlyProfit      Float    @default(0.0) @map("monthly_profit")
  peakEquity         Float    @default(50000.0) @map("peak_equity")
  maxDrawdownPercent Float    @default(0.0) @map("max_drawdown_percent")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("wallet_states")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@map("notifications")
}

model TradeAuditTimeline {
  id              String   @id @default(uuid())
  tradeId         String   @unique @map("trade_id")
  symbol          String
  stepsJson       String   @map("steps_json")
  totalDurationMs Float    @map("total_duration_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("trade_audit_timelines")
}

model ReconciliationLog {
  id              String   @id @default(uuid())
  reconciledAt    DateTime @default(now()) @map("reconciled_at")
  status          String   @default("MATCHED")
  mismatchesCount Int      @default(0) @map("mismatches_count")
  mismatchesJson  String   @map("mismatches_json")

  @@map("reconciliation_logs")
}

model OptimizationRun {
  id                 String   @id @default(uuid())
  symbol             String
  timeframe          String   @default("1H")
  strategyProfileId  String   @map("strategy_profile_id")
  strategyProfileName String  @map("strategy_profile_name")
  parametersJson     String   @map("parameters_json")
  metricsJson        String   @map("metrics_json")
  walkForwardJson    String   @map("walk_forward_json")
  monteCarloJson     String   @map("monte_carlo_json")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("optimization_runs")
}

model SystemErrorLog {
  id         String   @id @default(uuid())
  category   String
  message    String
  severity   String   @default("MEDIUM")
  stackTrace String?  @map("stack_trace")
  timestamp  DateTime @default(now())

  @@map("system_error_logs")
}

model SystemBackupRecord {
  id        String   @id @default(uuid())
  filename  String
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  status    String   @default("SUCCESS")

  @@map("system_backup_records")
}

model TradeReview {
  id               String   @id @default(uuid())
  tradeId          String   @unique @map("trade_id")
  aiReviewJson     String   @map("ai_review_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("trade_reviews")
}

model TradeJournalNote {
  id               String   @id @default(uuid())
  tradeId          String   @unique @map("trade_id")
  idea             String
  whyEntered       String   @map("why_entered")
  whyExited        String   @map("why_exited")
  mistakes         String
  lessons          String
  emotion          String   @default("CALM")
  confidenceBefore Int      @default(8) @map("confidence_before")
  confidenceAfter  Int      @default(8) @map("confidence_after")
  improvementNotes String   @map("improvement_notes")
  tagsJson         String   @map("tags_json")
  isFavorite       Boolean  @default(false) @map("is_favorite")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("trade_journal_notes")
}

model TradeSnapshot {
  id               String   @id @default(uuid())
  tradeId          String   @unique @map("trade_id")
  snapshotJson     String   @map("snapshot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("trade_snapshots")
}

model ShadowDecisionRecord {
  id                String   @id @default(uuid())
  symbol            String
  timeframe         String   @default("1H")
  strategyProfileId String   @map("strategy_profile_id")
  decision          String
  confidence        Float
  entryPrice        Float    @map("entry_price")
  stopLossPrice     Float    @map("stop_loss_price")
  takeProfitPrice   Float    @map("take_profit_price")
  positionSize      Float    @map("position_size")
  reasonCodesJson   String   @map("reason_codes_json")
  timestamp         DateTime @default(now())

  @@map("shadow_decision_records")
}

model MarketOutcomeValidation {
  id                 String   @id @default(uuid())
  decisionId         String   @unique @map("decision_id")
  tpHit              Boolean  @map("tp_hit")
  slHit              Boolean  @map("sl_hit")
  mfe                Float
  mae                Float
  holdDurationMinutes Int      @map("hold_duration_minutes")
  accuracyPercent    Float    @map("accuracy_percent")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("market_outcome_validations")
}

model ProductionReadinessReport {
  id                   String   @id @default(uuid())
  overallReadinessScore Float   @map("overall_readiness_score")
  isProductionReady    Boolean  @map("is_production_ready")
  reportJson           String   @map("report_json")
  generatedAt          DateTime @default(now()) @map("generated_at")

  @@map("production_readiness_reports")
}







